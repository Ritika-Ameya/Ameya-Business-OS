# ─── Server ───────────────────────────────────────────────
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Authentication ───────────────────────────────────────
# REQUIRED – used to sign JWT access tokens (min 32 chars recommended)
JWT_SECRET=change-me-to-a-strong-random-string
# Optional – separate secret for refresh tokens (defaults to JWT_SECRET + '_refresh')
# JWT_REFRESH_SECRET=another-strong-random-string
# Token lifetimes (ms‑style strings: "15m", "1h", "7d")
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Development API Key (optional) ──────────────────────
# When set, non-auth routes also require X-DEV-KEY header.
# Leave empty or remove in production — JWT auth is the primary gate.
# DEV_API_KEY=

# ─── Google Cloud / Sheets / Drive ────────────────────────
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ─── Google Drive Single-Admin OAuth (required for Drive uploads) ──
# Keep Sheets on service account. Drive uses one admin Gmail OAuth.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:3002/api/google-drive/callback
GOOGLE_DRIVE_ADMIN_EMAIL=abhaychat3@gmail.com
# 32+ random chars used to encrypt refresh token at rest.
# Keep this value STABLE across deploys — changing it invalidates the stored token.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=AmeyaBusinessOS@2026$SuperSecretEncryptionKey123
# Optional local cache path (durable source of truth is Settings sheet).
# GOOGLE_DRIVE_TOKEN_STORE_PATH=data/google-drive-token.enc

# Optional tuning
# GOOGLE_REQUEST_TIMEOUT_MS=30000
# GOOGLE_MAX_RETRIES=3
